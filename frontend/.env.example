# Copy to frontend/.env.local if needed.

# API base path. Keep "/api" so requests stay same-origin (Vite proxy in dev,
# Vercel rewrite in production). The session cookie depends on this.
VITE_API_BASE_URL=/api

# Where the Vite dev server proxies /api (dev only; not exposed to the browser).
DEV_BACKEND_URL=http://localhost:8000

# Copy to backend/.env for local development. Never commit the real .env.

# Local Postgres (Postgres.app / Homebrew). Railway provides DATABASE_URL in production.
DATABASE_URL=postgres://localhost:5432/finance_dev

# Required in production; dev uses an insecure default if unset.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Comma-separated lists
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Public sign-up (dev default: true, production default: false)
ALLOW_REGISTRATION=true

# Settings module: config.settings.dev (default for manage.py) or config.settings.prod
# DJANGO_SETTINGS_MODULE=config.settings.dev
